{{ 'gilgamesh-forbidden-shelf.css' | asset_url | stylesheet_tag }}

<section
  id="GilgameshForbiddenShelf-{{ section.id }}"
  class="gb-forbidden"
  aria-labelledby="GilgameshForbiddenTitle-{{ section.id }}"
  style="--gb-forbidden-accent: {{ section.settings.accent_color }};"
>
  <div class="gb-forbidden__layout{% if section.settings.image_position == 'right' %} gb-forbidden__layout--reversed{% endif %}">
    <div class="gb-forbidden__visual">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'gb-forbidden__image',
            loading: 'lazy',
            widths: '375, 550, 750, 1100, 1500, 1800',
            sizes: '(min-width: 750px) 50vw, 100vw'
        }}
      {%- else -%}
        <div class="gb-forbidden__image-placeholder" aria-hidden="true">
          <span class="gb-forbidden__placeholder-icon">✧</span>
        </div>
      {%- endif -%}
      <div class="gb-forbidden__image-shade" aria-hidden="true"></div>
      {%- if section.settings.image_caption != blank -%}
        <p class="gb-forbidden__image-caption">{{ section.settings.image_caption | escape }}</p>
      {%- endif -%}
    </div>

    <div class="gb-forbidden__panel">
      <div class="gb-forbidden__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="gb-forbidden__eyebrow"><span aria-hidden="true" class="gb-forbidden__rule"></span>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 id="GilgameshForbiddenTitle-{{ section.id }}" class="gb-forbidden__heading">{{ section.settings.heading | escape }}</h2>

        {%- if section.settings.description != blank -%}
          <div class="gb-forbidden__description rte">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.settings.link_label != blank -%}
          {%- if section.settings.collection != blank -%}
            {%- assign shelf_href = section.settings.collection.url -%}
          {%- else -%}
            {%- assign shelf_href = section.settings.link -%}
          {%- endif -%}
          {%- if shelf_href != blank -%}
            <a class="gb-forbidden__button" href="{{ shelf_href }}">
              {{ section.settings.link_label | escape }}<span aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="gb-forbidden__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gilgamesh Forbidden Shelf",
  "tag": "section",
  "class": "section-gilgamesh-forbidden-shelf",
  "settings": [
    {"type": "image_picker", "id": "image", "label": "Editorial image"},
    {"type": "select", "id": "image_position", "label": "Image position on desktop", "options": [{"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "left"},
    {"type": "text", "id": "image_caption", "label": "Image caption (optional)"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Forbidden Shelf"},
    {"type": "text", "id": "heading", "label": "Headline", "default": "Read What They Tried to Remove."},
    {"type": "richtext", "id": "description", "label": "Description", "default": "<p>Explore books challenged, censored, or suppressed across history — and the stories behind their enduring significance.</p>"},
    {"type": "collection", "id": "collection", "label": "Destination collection"},
    {"type": "url", "id": "link", "label": "Alternate destination (used if no collection selected)"},
    {"type": "text", "id": "link_label", "label": "Button label", "default": "Explore banned books"},
    {"type": "text", "id": "note", "label": "Small note below button (optional)"},
    {"type": "color", "id": "accent_color", "label": "Editorial accent", "default": "#9D402F"}
  ],
  "presets": [{"name": "Gilgamesh Forbidden Shelf"}]
}
{% endschema %}
