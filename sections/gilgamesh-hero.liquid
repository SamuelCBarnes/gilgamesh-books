{%- style -%}
  #gb-hero-{{ section.id }} {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: {{ section.settings.desktop_height }}px;
    display: flex; align-items: center;
    color: #faf6ed;
    background: radial-gradient(circle at 76% 34%, #71563c 0%, #354135 33%, #17291f 74%);
  }
  #gb-hero-{{ section.id }} .gb-hero__media { position: absolute; inset: 0; z-index: -2; }
  #gb-hero-{{ section.id }} .gb-hero__image { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  #gb-hero-{{ section.id }}::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgba(15,28,21,.93) 0%, rgba(15,28,21,.86) 34%, rgba(15,28,21,.48) 68%, rgba(15,28,21,.12) 100%);
  }
  #gb-hero-{{ section.id }} .gb-hero__inner { width: min(100%, 1440px); margin: 0 auto; padding: 8rem 5rem; }
  #gb-hero-{{ section.id }} .gb-hero__content { max-width: 700px; }
  #gb-hero-{{ section.id }} .gb-hero__eyebrow { margin: 0 0 2rem; font: 600 1.15rem/1.5 Arial, sans-serif; letter-spacing: .25em; text-transform: uppercase; color: #e4c58d; }
  #gb-hero-{{ section.id }} .gb-hero__title { margin: 0 0 2.2rem; font: normal clamp(3.7rem, 5.2vw, 7.4rem)/1.08 Georgia, serif; letter-spacing: -.03em; color: #fff8e8; }
  #gb-hero-{{ section.id }} .gb-hero__text { max-width: 540px; font: 1.7rem/1.7 Georgia, serif; color: #f1e6d2; }
  #gb-hero-{{ section.id }} .gb-hero__text p { margin: 0 0 3rem; }
  #gb-hero-{{ section.id }} .gb-hero__link { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 1.3rem 2.6rem; background: #6b4c5c; border: 1px solid #c8a77d; color: #fff; font: 600 1.2rem/1.2 Arial,sans-serif; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; transition: background .2s ease; }
  #gb-hero-{{ section.id }} .gb-hero__link:hover { background: #553949; }
  #gb-hero-{{ section.id }} .gb-hero__link:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  #gb-hero-{{ section.id }} .gb-hero__accent { width: 80px; border-top: 2px solid #b28a4a; margin: 0 0 2.2rem; }
  @media (max-width: 749px) {
    #gb-hero-{{ section.id }} { min-height: {{ section.settings.mobile_height }}px; align-items: flex-end; }
    #gb-hero-{{ section.id }}::before { background: linear-gradient(0deg, rgba(15,28,21,.96) 0%, rgba(15,28,21,.75) 55%, rgba(15,28,21,.28) 100%); }
    #gb-hero-{{ section.id }} .gb-hero__inner { padding: 7rem 2.4rem 5rem; }
    #gb-hero-{{ section.id }} .gb-hero__title { font-size: clamp(3.5rem, 10vw, 5.4rem); }
    #gb-hero-{{ section.id }} .gb-hero__text { font-size: 1.5rem; }
    #gb-hero-{{ section.id }} .gb-hero__eyebrow { font-size: 1rem; }
    #gb-hero-{{ section.id }} .gb-hero__image { object-position: 62% center; }
  }
{%- endstyle -%}

<section id="gb-hero-{{ section.id }}" class="gb-hero" aria-labelledby="gb-hero-heading-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <div class="gb-hero__media">
      {%- liquid
        assign hero_priority = 'auto'
        if section.index == 1
          assign hero_priority = 'high'
        endif
      -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'gb-hero__image', widths: '640, 960, 1280, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: hero_priority }}
    </div>
  {%- endif -%}
  <div class="gb-hero__inner">
    <div class="gb-hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="gb-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <div class="gb-hero__accent" aria-hidden="true"></div>
      <h1 id="gb-hero-heading-{{ section.id }}" class="gb-hero__title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.description != blank -%}<div class="gb-hero__text">{{ section.settings.description }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="gb-hero__link" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">&nbsp;→</span></a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gilgamesh editorial hero",
  "tag": "section",
  "class": "section-gilgamesh-hero",
  "settings": [
    {"type": "image_picker", "id": "image", "label": "Hero background image"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Rare · Banned · Collectible"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Exceptional Books for Discerning Collectors"},
    {"type": "richtext", "id": "description", "label": "Description", "default": "<p>Uncommon editions, remarkable histories, and books worth keeping — thoughtfully curated by Gilgamesh Books.</p>"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Explore the collection"},
    {"type": "url", "id": "button_link", "label": "Button destination"},
    {"type": "range", "id": "desktop_height", "label": "Desktop minimum height", "min": 440, "max": 820, "step": 20, "unit": "px", "default": 600},
    {"type": "range", "id": "mobile_height", "label": "Mobile minimum height", "min": 440, "max": 760, "step": 20, "unit": "px", "default": 560}
  ],
  "presets": [{"name": "Gilgamesh editorial hero"}]
}
{% endschema %}
